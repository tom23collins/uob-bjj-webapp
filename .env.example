# Copy this file to .env on the Raspberry Pi and replace every placeholder.
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=uob_bjj
POSTGRES_USER=uob_bjj
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional: leave blank to disable welcome emails.
MAIL_KEY=

# Optional public links.
INSTAGRAM_URL=https://instagram.com/uob_bjj
WHATSAPP_URL=https://linktr.ee/uobbjj
MEMBERSHIP_URL=https://www.usbonline.bham.ac.uk/JoinAtHome/

# Optional public access through Cloudflare Tunnel. Create the tunnel first,
# then paste its token here and start with: docker compose --profile public up -d
CLOUDFLARE_TUNNEL_TOKEN=
